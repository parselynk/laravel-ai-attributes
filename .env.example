# Environment variables used by parselynk/laravel-ai-attributes.
#
# Add the ones you need to your application's .env file — you do not need to
# copy this whole file. Everything is optional except a provider credential.

# ---------------------------------------------------------------------------
# Provider credentials — read by laravel/ai, configured in config/ai.php
# ---------------------------------------------------------------------------

OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Ollama runs locally and needs no API key.
# OLLAMA_URL=http://localhost:11434

# ---------------------------------------------------------------------------
# Package settings — see config/ai-attributes.php
# ---------------------------------------------------------------------------

# Provider used when an attribute does not name one.
# Must match a key in config/ai.php. Leave unset to use laravel/ai's default.
AI_ATTRIBUTES_PROVIDER=openai

# Seconds to wait for a single AI call.
AI_ATTRIBUTES_TIMEOUT=60

# Caching of generated values.
AI_ATTRIBUTES_CACHE_ENABLED=true
AI_ATTRIBUTES_CACHE_TTL=2592000
# AI_ATTRIBUTES_CACHE_STORE=redis
# AI_ATTRIBUTES_CACHE_PREFIX=ai_attr
